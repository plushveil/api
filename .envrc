#!/usr/bin/env sh

# direnv is a shell extension that automatically loads and unloads environment variables
# based on the current directory. It is commonly used to manage project-specific environment
# variables without polluting the global shell environment. When entering a directory containing
# an `.envrc` file, direnv reads and applies the environment settings defined within, and
# automatically reverts them when leaving the directory.
#
# `.env` files are typically used to store sensitive environment variables such as API keys,
# database credentials, and other configuration values required for local development. These
# files are intentionally excluded from version control (e.g., via `.gitignore`) to prevent
# accidental exposure of secrets and to allow developers to maintain their own local settings.
#
# In contrast, `.devcontainer/.env` is included in version control and serves as a template or example
# for the required environment variables. It does not contain sensitive values, but rather
# documents the variable names and expected formats. This approach helps ensure consistency
# across development environments and makes it easier for new contributors to set up their
# local configuration by copying it and customizing a `.env` file.

set -a
source .devcontainer/.env
[ -f .env ] && source .env
set +a
